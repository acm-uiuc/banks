---
import { Image } from 'astro:assets';
import Layout from '@/layouts/Base.astro';
import { getCurrentIssueArticles } from '@/lib/collections';
import { formatDate, byline } from '@/lib/utils';
import config from '@/config';

const articles = await getCurrentIssueArticles();
const issue = config.currentIssue;
const issueDate = issue ? new Date(issue.date) : undefined;
---
<Layout>
  <section class="max-w-3xl mx-auto py-6">
    {issue && (
      <header class="text-center mb-10">
        <p class="text-sm tracking-[0.2em] uppercase text-gray-500">
          Vol. {issue.volume}, No. {issue.number}
          {issueDate && <> &middot; {issueDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}</>}
        </p>
        {issue.title && (
          <h1 class="font-headline font-bold text-3xl mt-2">{issue.title}</h1>
        )}
      </header>
    )}

    {articles.length === 0 ? (
      <p class="text-center text-gray-500 py-16">
        No articles in the current issue yet. Check back soon.
      </p>
    ) : (
      <ul class="divide-y divide-gray-200">
        {articles.map((article) => (
          <li>
            <a href={article.fullSlug} class="group flex gap-6 py-8 items-start">
              <div class="flex-1 min-w-0">
                <h2 class="font-headline font-bold text-2xl md:text-3xl leading-tight group-hover:underline">
                  {article.data.title}
                </h2>
                {article.data.subtitle && (
                  <p class="mt-2 text-lg text-gray-600">{article.data.subtitle}</p>
                )}
                <p class="mt-2 text-gray-700 line-clamp-2">{article.excerpt}</p>
                <p class="mt-3 text-sm text-gray-500">
                  {byline(article.data)}
                  {(article.data.date ?? issueDate) && (
                    <> &middot; {formatDate(article.data.date ?? issueDate)}</>
                  )}
                </p>
              </div>
              {article.data.image && (
                <Image
                  src={article.data.image.src}
                  alt={article.data.image.alt}
                  width={352}
                  height={224}
                  class="w-28 h-20 md:w-44 md:h-28 object-cover rounded shrink-0"
                />
              )}
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Layout>
