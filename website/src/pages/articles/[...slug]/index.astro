---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Layout from '@/layouts/Base.astro';
import { getCurrentIssueArticles } from '@/lib/collections';
import { formatDate, byline } from '@/lib/utils';
import config from '@/config';

export async function getStaticPaths() {
  const articles = await getCurrentIssueArticles();
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const data = article.data;
const date = data.date ?? (config.currentIssue ? new Date(config.currentIssue.date) : undefined);
---
<Layout title={data.title} description={data.subtitle}>
  <article class="prose prose-lg lg:prose-xl mx-auto my-10">
    <header class="not-prose mb-8">
      <h1 class="font-headline font-bold text-4xl md:text-5xl leading-tight">{data.title}</h1>
      {data.subtitle && (
        <p class="mt-3 text-xl text-gray-600">{data.subtitle}</p>
      )}
      <p class="mt-5 text-sm text-gray-500">
        {byline(data)}
        {date && <> &middot; {formatDate(date)}</>}
      </p>
    </header>

    {data.image && (
      <figure>
        <Image src={data.image.src} alt={data.image.alt} class="rounded w-full" />
        {data.image.attribution && (
          <figcaption class="text-sm text-gray-500">{data.image.attribution}</figcaption>
        )}
      </figure>
    )}

    <Content />

    <hr class="my-10" />
    <p class="not-prose text-sm text-gray-500">
      <a href="/" class="hover:underline">&larr; Back to the current issue</a>
    </p>
  </article>
</Layout>
